NODE_ENV=production
PORT=8080

LOG_TIME_ZONE=Asia/Tokyo
LOG_LANGUAGE=ja
LOG_FORMAT=YYYY-MM-DD HH:mm:ss

APP_NAME=JSKI

# --- StarPay (NetStars) 支付配置 ---
# 支付功能总开关：未完成测试前保持 false（false 时不加载支付路由，无需任何 NSS_* 配置）
PAYMENT_ENABLED=false
# NSS_MOCK=true 仅用于本地开发（生产环境设为 true 会拒绝启动）
NSS_MOCK=false
# QA 环境：https://qa-starpay-cashier.nsstest.com （生产域名由 NSS 提供）
NSS_BASE_URL=
# 以下均由 NSS 开户时发行
NSS_OEM_ID=
NSS_SYS_MERCHANT_ID=
NSS_MERCHANT_ID=
# RSA 密钥文件路径（相对项目根目录；config/keys/ 已 gitignore，服务器手动放置）
NSS_PRIVATE_KEY_PATH=config/keys/nss_private.pem
NSS_PUBLIC_KEY_PATH=config/keys/nss_public.pem
NSS_FRONT_CALLBACK_URL=https://jcosa.net/payment/result
NSS_NOTIFY_URL=https://jcosa.net/payment/notify
# 表单 nonce 的 HMAC 密钥（随机长字符串，如 openssl rand -hex 32 生成）
PAY_FORM_SECRET=
# SQLite 数据文件路径（容器内 /app/data 挂了 payment-data volume）
SQLITE_PATH=/app/data/payment.db
# 对账兜底：PAYING 超过 3 分钟未终态主动查单；订单 24 小时未支付关闭
PAY_RECONCILE_INTERVAL_MS=60000
PAY_RECONCILE_STALE_MIN=3
PAY_ORDER_EXPIRE_HOURS=24
